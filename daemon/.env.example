# Copiar a .env (o inyectar como variables de entorno reales del servicio) y completar.
# Nunca commitear el .env real.

SERVER_URL=https://api.empresa.cl
JWT_TOKEN=reemplazar-con-el-token-emitido-para-este-equipo
# Generar con: node scripts/generate-key.js
DB_ENCRYPTION_KEY=reemplazar-con-64-caracteres-hex

# Opcionales
SERVER_RECORDS_PATH=/api/device-records
COLLECT_INTERVAL_MS=900000
DAEMON_DATA_DIR=
# Si se completa, cada snapshot intenta resolver lat/long via Google Geolocation
# API a partir del WiFi visible (requiere API key con Geolocation API habilitada
# en Google Cloud). Si se deja vacio, lat/long van siempre null.
GOOGLE_GEOLOCATION_API_KEY=
